# System properties for Innioasis G3

# Device identification
ro.product.device=g3
ro.product.model=G3
ro.product.name=lineage_g3
ro.product.brand=Innioasis
ro.product.manufacturer=Innioasis

# Platform
ro.mediatek.platform=MT6753
ro.hardware=mt6753
ro.board.platform=mt6753
ro.chipname=mt6753

# Build
ro.build.description=lineage_g3-userdebug 14 UP1A.231005.007 eng.creator.20261111 test-keys
ro.build.fingerprint=Innioasis/lineage_g3/g3:14/UP1A.231005.007/eng.creator.20261111:userdebug/test-keys

# Lineage
ro.lineage.version=21.0-20261111-UNOFFICIAL-g3
ro.lineage.releasetype=UNOFFICIAL
ro.lineage.build.version=21
ro.lineage.device=g3

# Memory optimizations
ro.config.low_ram=true
ro.config.max_starting_bg=8
ro.sys.fw.bg_apps_limit=16
ro.sys.fw.use_trim_settings=true
ro.sys.fw.empty_app_percent=50
ro.sys.fw.trim_empty_percent=100
ro.sys.fw.trim_cache_percent=100
ro.sys.fw.trim_enable_memory=1073741824

# Dalvik/ART
dalvik.vm.heapstartsize=4m
dalvik.vm.heapgrowthlimit=64m
dalvik.vm.heapsize=128m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=2m
dalvik.vm.image-dex2oat-filter=speed
dalvik.vm.dex2oat-filter=speed
dalvik.vm.usejit=true
dalvik.vm.usejitprofiles=true
dalvik.vm.jitinitialsize=1m
dalvik.vm.jitmaxsize=32m

# ZRAM
ro.zram.mark_idle_delay_mins=60
ro.zram.first_wb_delay_mins=1440
ro.zram.periodic_wb_delay_hours=24

# LMK
ro.lmk.low=1001
ro.lmk.medium=800
ro.lmk.high=600
ro.lmk.critical=400
ro.lmk.swap_util_max=90

# SurfaceFlinger
debug.sf.latch_unsignaled=1
debug.sf.enable_hwc_vds=1
debug.sf.use_phase_offsets_as_durations=1
debug.sf.early_phase_offset_ns=500000
debug.sf.early_app_phase_offset_ns=500000
debug.sf.early_gl_phase_offset_ns=3000000
debug.sf.early_gl_app_phase_offset_ns=15000000

# Graphics
ro.surface_flinger.max_frame_buffer_acquired_buffers=2
ro.surface_flinger.max_virtual_display_dimension=2048
ro.surface_flinger.force_hwc_copy_for_virtual_displays=true
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.use_color_management=false
ro.surface_flinger.protected_contents=true

# Display density
ro.sf.lcd_density=240

# Audio
ro.audio.monitorRotation=true
ro.config.media_volume_steps=25
ro.config.vc_call_vol_steps=7
ro.config.alarm_alert=Alarm_Classic.ogg
ro.config.notification_sound=pixiedust.ogg
ro.config.ringtone=Ring_Synth_04.ogg

# Bluetooth
ro.bluetooth.a2dp_offload.supported=true
persist.bluetooth.a2dp_offload.disabled=false

# WiFi
wifi.interface=wlan0
wifi.supplicant_scan_interval=15

# Power
ro.powerhal.dynamic_accelerator=true
ro.powerhal.cpu_boost_duration=100

# Camera
ro.camera.enableZSL=true
persist.camera.privapp.list=com.innioasis.camera

# Media
media.stagefright.enable-aac=true
media.stagefright.enable-fma2dp=true
media.stagefright.enable-http=true
media.stagefright.enable-player=true
media.stagefright.enable-qcp=true
media.stagefright.enable-scan=true

# DRM
drm.service.enabled=true

# USB
persist.sys.usb.config=mtp,adb

# Debug
ro.debuggable=1
ro.adb.secure=0
ro.secure=0
persist.sys.root_access=3