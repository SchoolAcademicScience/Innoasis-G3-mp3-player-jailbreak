# init.mt6753.rc for Innioasis G3

on early-init
    # Set up cgroups for memory management (critical for 128MB target)
    write /dev/cpuset/cpus 0-7
    write /dev/cpuset/mems 0

    # Mount critical filesystems early
    mount tmpfs tmpfs /dev mode=0755 uid=0 gid=0
    mount devpts devpts /dev/pts mode=0600 gid=2000
    mount proc proc /proc nosuid nodev noexec
    mount sysfs sysfs /sys nosuid nodev noexec
    mount selinuxfs selinuxfs /sys/fs/selinux

    # Set kernel parameters for low memory
    write /proc/sys/vm/overcommit_memory 1
    write /proc/sys/vm/min_free_kbytes 8192
    write /proc/sys/vm/dirty_ratio 10
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 200
    write /proc/sys/vm/page-cluster 0
    write /proc/sys/vm/zone_reclaim_mode 1

    # ZRAM setup
    write /sys/block/zram0/disksize 134217728
    write /sys/block/zram0/comp_algorithm lz4
    write /sys/block/zram0/max_comp_streams 4

on init
    # Enable ZRAM swap
    swapon_all /vendor/etc/fstab.mt6753

    # Set CPU governor for power efficiency
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu1/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu2/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu3/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu5/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu6/cpufreq/scaling_governor schedutil
    write /sys/devices/system/cpu/cpu7/cpufreq/scaling_governor schedutil

    # Set minimum frequencies for responsiveness
    write /sys/devices/system/cpu/cpu0/cpufreq/scaling_min_freq 400000
    write /sys/devices/system/cpu/cpu4/cpufreq/scaling_min_freq 400000

    # GPU governor
    write /sys/class/devfreq/mali/device/devfreq/governor simple_ondemand

    # MediaTek thermal management
    write /sys/devices/virtual/thermal/thermal_zone0/mode enabled
    write /sys/devices/virtual/thermal/thermal_zone1/mode enabled

    # I/O scheduler
    write /sys/block/mmcblk0/queue/scheduler bfq
    write /sys/block/mmcblk0/queue/read_ahead_kb 256

    # Enable KSM for memory deduplication
    write /sys/kernel/mm/ksm/run 1
    write /sys/kernel/mm/ksm/sleep_millisecs 1000
    write /sys/kernel/mm/ksm/pages_to_scan 100

    # Low memory killer tuning for 128MB target
    write /sys/module/lowmemorykiller/parameters/minfree "14746,18432,22118,25805,40000,55000"
    write /sys/module/lowmemorykiller/parameters/enable_adaptive_lmk 1
    write /sys/module/lowmemorykiller/parameters/vmpressure_file_min 524288

    # Disable unnecessary services
    setprop ro.config.low_ram true
    setprop ro.config.max_starting_bg 8
    setprop ro.sys.fw.bg_apps_limit 16
    setprop ro.sys.fw.use_trim_settings true
    setprop ro.sys.fw.empty_app_percent 50
    setprop ro.sys.fw.trim_empty_percent 100
    setprop ro.sys.fw.trim_cache_percent 100
    setprop ro.sys.fw.trim_enable_memory 1073741824

    # SurfaceFlinger optimizations
    setprop debug.sf.latch_unsignaled 1
    setprop debug.sf.enable_hwc_vds 1
    setprop debug.sf.use_phase_offsets_as_durations 1
    setprop debug.sf.early_phase_offset_ns 500000
    setprop debug.sf.early_app_phase_offset_ns 500000
    setprop debug.sf.early_gl_phase_offset_ns 3000000
    setprop debug.sf.early_gl_app_phase_offset_ns 15000000

    # Graphics memory optimizations
    setprop ro.surface_flinger.max_frame_buffer_acquired_buffers 2
    setprop ro.surface_flinger.max_virtual_display_dimension 2048
    setprop ro.surface_flinger.force_hwc_copy_for_virtual_displays true
    setprop ro.surface_flinger.has_wide_color_display false
    setprop ro.surface_flinger.has_HDR_display false
    setprop ro.surface_flinger.use_color_management false

    # Dalvik/ART optimizations
    setprop dalvik.vm.heapstartsize 4m
    setprop dalvik.vm.heapgrowthlimit 64m
    setprop dalvik.vm.heapsize 128m
    setprop dalvik.vm.heaptargetutilization 0.75
    setprop dalvik.vm.heapminfree 512k
    setprop dalvik.vm.heapmaxfree 2m
    setprop dalvik.vm.image-dex2oat-filter speed
    setprop dalvik.vm.dex2oat-filter speed
    setprop dalvik.vm.usejit true
    setprop dalvik.vm.usejitprofiles true
    setprop dalvik.vm.jitinitialsize 1m
    setprop dalvik.vm.jitmaxsize 32m

    # Zygote optimizations
    setprop persist.sys.zygote_critical_window_minutes 30

    # Disable heavy features
    setprop ro.config.low_ram true
    setprop ro.config.max_starting_bg 8
    setprop ro.sys.fw.bg_apps_limit 16
    setprop ro.config.max_icon_bytes 8192

    # Media optimizations
    setprop media.stagefright.enable-aac true
    setprop media.stagefright.enable-fma2dp true
    setprop media.stagefright.enable-http true
    setprop media.stagefright.enable-player true
    setprop media.stagefright.enable-qcp true
    setprop media.stagefright.enable-scan true

    # Audio
    setprop ro.audio.monitorRotation true
    setprop ro.config.media_volume_steps 25
    setprop ro.config.vc_call_vol_steps 7

    # Bluetooth
    setprop ro.bluetooth.a2dp_offload.supported true
    setprop persist.bluetooth.a2dp_offload.disabled false

    # WiFi
    setprop wifi.interface wlan0
    setprop wifi.supplicant_scan_interval 15

    # Power
    setprop ro.powerhal.dynamic_accelerator true
    setprop ro.powerhal.cpu_boost_duration 100

    # Disable verbose logging
    setprop log.tag.* V

on late-init
    # Trigger zygote restart with optimized settings
    trigger zygote_restart

on property:sys.boot_completed=1
    # Post-boot optimizations
    write /proc/sys/vm/drop_caches 3
    write /proc/sys/vm/compact_memory 1

    # Trim unused memory
    fstrim /data
    fstrim /cache

    # Set dex2oat threads
    setprop dalvik.vm.dex2oat-threads 4
    setprop dalvik.vm.image-dex2oat-threads 4

    # Enable App Standby Buckets
    setprop ro.build.type user
    setprop ro.debuggable 0

service vendor.fstab /vendor/bin/sh -c "wait /dev/block/by-name/userdata; mount_all /vendor/etc/fstab.mt6753"
    class late_start
    oneshot

service zram-init /vendor/bin/sh -c "mkswap /dev/block/zram0 && swapon /dev/block/zram0 -p 32758"
    class early_hal
    oneshot
    disabled

service ksm /vendor/bin/sh -c "echo 1 > /sys/kernel/mm/ksm/run"
    class late_start
    oneshot