<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="@dimen/dock_item_padding_vertical">

    <com.innioasis.launcher3.views.AppIconView
        android:id="@+id/app_icon"
        android:layout_width="@dimen/dock_icon_size"
        android:layout_height="@dimen/dock_icon_size" />

    <TextView
        android:id="@+id/app_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dock_label_margin_top"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dock_label"
        android:textSize="@dimen/dock_label_text_size" />

</LinearLayout>